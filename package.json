{
  "name": "penguin-stream",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Low-friction peer-to-peer remote desktop with CGNAT relay fallback",
  "bin": {
    "penguin-stream": "./node/src/cli.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=65000 node/test/",
    "test:unit": "node --test node/test/unit/",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=120000 node/test/integration/",
    "host": "node node/src/cli.mjs host",
    "connect": "node node/src/cli.mjs connect",
    "rendezvous": "node node/src/cli.mjs rendezvous",
    "turn": "node turn/src/server.mjs"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.2.0",
    "node-datachannel": "^0.33.4",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
